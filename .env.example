# Copy to .env.local and fill in real values. Never commit .env.local.
#
# The Supabase-prefixed and POSTGRES_* variables below are normally injected
# automatically by `vercel integration add supabase` + `vercel env pull`.
# Fill them in manually only if you are wiring up an existing Supabase
# project outside the Vercel Marketplace flow — see README.md.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by scripts/migrate.ts.
# Use the *non-pooling* connection string (DDL/transactions need a direct
# connection, not the pgbouncer pooler).
POSTGRES_URL_NON_POOLING=

# --- App secrets (generate your own, do not reuse these) -------------------
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32
ACCESS_CODE_PEPPER=
